# Hook AI Backend - Environment Variables
# =========================================

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://hookai:hookai_pass@localhost:5432/hookai

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change_me_to_a_random_64_char_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Video Limits
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE=storage

# S3 (if STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI Device
HOOK_AI_DEVICE=auto
HOOK_AI_PROFILE=balanced

# Models
WHISPER_MODEL=openai/whisper-large-v3-turbo
WHISPER_MODEL_SIZE=base
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
VISION_MODEL=Qwen/Qwen3-VL-4B-Instruct
TEXT_GENERATION_MODEL=microsoft/Phi-3-mini-4k-instruct

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Cleanup
TEMP_FILE_RETENTION_HOURS=24

# Score Weights (must sum to 1.0)
SCORE_WEIGHT_HOOK=0.25
SCORE_WEIGHT_CTA=0.15
SCORE_WEIGHT_TONE=0.10
SCORE_WEIGHT_VISUAL=0.15
SCORE_WEIGHT_PACING=0.10
SCORE_WEIGHT_CLARITY=0.10
SCORE_WEIGHT_ENGAGEMENT=0.15

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SIGNUP=3/minute
RATE_LIMIT_ANALYSIS=10/hour
